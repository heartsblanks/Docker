# Copy this file to .env and fill in real values before starting the environment.
# `.env` is gitignored on purpose — never commit real passwords.
#
# IMPORTANT: IBM (and Oracle) frequently retag/rotate their public dev/trial
# images. Before first run, confirm the current tags on:
#   - IBM MQ:  https://hub.docker.com/r/ibm-messaging/mq  (or icr.io/ibm-messaging/mq)
#   - IBM ACE: https://hub.docker.com/r/ibm-messaging/ace (or icr.io/appconnect/ace)
#   - IBM Db2: https://hub.docker.com/r/ibm-db2/db2 (or icr.io/db2_community/db2)
#   - Oracle:  https://hub.docker.com/r/gvenzl/oracle-free
# and update the *_TAG values below. The values here are known-good as of
# late 2025 but are NOT guaranteed to still exist by the time you read this.

# ---------------------------------------------------------------------------
# IBM MQ 9.5 (developer/trial edition — no entitlement key required)
# ---------------------------------------------------------------------------
MQ_IMAGE=icr.io/ibm-messaging/mq
MQ_TAG=9.5.0.0-r1
MQ_QMGR_NAME=QM1
MQ_APP_PASSWORD=changeMe_app!
MQ_ADMIN_PASSWORD=changeMe_admin!

# ---------------------------------------------------------------------------
# IBM App Connect Enterprise (developer/trial edition, single integration node/server)
# ---------------------------------------------------------------------------
ACE_IMAGE=icr.io/appconnect/ace
ACE_TAG=12.0.12.0-r1
ACE_SERVER_NAME=DEV_NODE

# ---------------------------------------------------------------------------
# IBM Db2 (developer/trial edition) — three instances:
#   1) db2-orders     : a normal LUW application database
#   2) db2-customer   : a second normal LUW application database
#   3) db2-mainframe  : stand-in for the "mainframe" Db2 (Db2 for z/OS is not
#                        container-runnable, so this is a plain Db2 LUW
#                        container named/ported to represent that connection
#                        for local dev/testing of message flows)
# ---------------------------------------------------------------------------
DB2_IMAGE=icr.io/db2_community/db2
DB2_TAG=11.5.9.0

DB2_ORDERS_PASSWORD=changeMe_orders!
DB2_ORDERS_DBNAME=ORDERSDB
DB2_ORDERS_PORT=50000

DB2_CUSTOMER_PASSWORD=changeMe_customer!
DB2_CUSTOMER_DBNAME=CUSTDB
DB2_CUSTOMER_PORT=50001

DB2_MAINFRAME_PASSWORD=changeMe_mainframe!
DB2_MAINFRAME_DBNAME=MFDB
DB2_MAINFRAME_PORT=50002

# ---------------------------------------------------------------------------
# Oracle (using gvenzl/oracle-free — the community-maintained, license-clean
# equivalent of Oracle XE; official Oracle images require an Oracle Container
# Registry login and license acceptance, so this is the practical dev-box choice)
# ---------------------------------------------------------------------------
ORACLE_IMAGE=gvenzl/oracle-free
ORACLE_TAG=23.5-slim
ORACLE_PASSWORD=changeMe_oracle_sys!
ORACLE_APP_USER=aceapp
ORACLE_APP_PASSWORD=changeMe_oracle_app!
